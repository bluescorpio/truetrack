# HyperEVM TrackRecordRegistry (chain id 999). Leave blank until you deploy.
NEXT_PUBLIC_REGISTRY_ADDRESS=
# HyperEVM JSON-RPC. The keeper and the server-side registry reader both use this.
HYPERLIQUID_RPC=https://rpc.hyperliquid.xyz/evm
# Authorized attester key. Never commit a real key.
ATTESTER_PRIVATE_KEY=
# Comma-separated Hyperliquid wallets the keeper snapshots.
WATCHED_TRADERS=
